<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#111827">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Vicky Pay">
  <meta name="format-detection" content="telephone=no">
  <link rel="manifest" href="manifest.webmanifest">
  <link rel="apple-touch-icon" href="icon-192.png">
  <title>Vicky Pay</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

<div class="app">

  <header class="topbar">
    <div>
      <h1>Vicky Pay</h1>
      <p>Simple. Secure. Yours.</p>
    </div>
    <button id="logoutBtn" class="logout hidden" onclick="logout()">Logout</button>
  </header>

  <main>

    
<section id="depositScreen" class="money-screen hidden">
  <div class="money-screen-header">
    <button type="button" class="back-button" onclick="closeMoneyScreen()">←</button>
    <div>
      <small>Vicky Pay</small>
      <h2>Deposit Money</h2>
    </div>
  </div>

  <div class="money-screen-card">
    <div class="money-screen-icon">＋</div>

    <h3>Add money to your wallet</h3>
    <p>Choose how you want to fund your Vicky Pay wallet.</p>

    <label>Funding Source</label>
    <select id="depositFundingSource" class="money-input">
      <option value="">Choose funding source</option>
      <option value="bank">Bank Account</option>
      <option value="card">Credit / Debit Card</option>
      <option value="wallet">Other Wallet</option>
    </select>

    <div id="depositBankFields" class="hidden">
      <label>Bank Name</label>
      <input id="depositBankName" type="text"
        placeholder="Enter bank name">

      <label>Bank Account Number</label>
      <input id="depositBankAccount" type="text"
        inputmode="numeric"
        placeholder="Enter account number">
    </div>

    <div id="depositCardFields" class="hidden">
      <div class="recipient-preview">
        <strong>Credit / Debit Card</strong>
        <span>Secure card payment will be used to fund your wallet.</span>
      </div>
    </div>

    <div id="depositWalletFields" class="hidden">
      <label>Wallet Provider</label>
      <input id="depositWalletProvider" type="text"
        placeholder="e.g. MTN, Moov, Airtel">

      <label>Wallet Number / Account</label>
      <input id="depositWalletAccount" type="text"
        placeholder="Enter wallet number">
    </div>

    <label>Amount</label>
    <input id="depositAmount"
      type="number"
      min="0.01"
      step="0.01"
      placeholder="0.00"
      inputmode="decimal">

    <label>Description</label>
    <input id="depositDescription"
      type="text"
      placeholder="Description (optional)">

    <button class="primary money-submit"
      type="button"
      onclick="deposit()">
      Continue Deposit
    </button>

    <div id="depositScreenMessage"></div>
  </div>
</section>


<section id="withdrawScreen" class="money-screen hidden">
  <div class="money-screen-header">
    <button type="button" class="back-button" onclick="closeMoneyScreen()">←</button>
    <div>
      <small>Vicky Pay</small>
      <h2>Withdraw Money</h2>
    </div>
  </div>

  <div class="money-screen-card">
    <div class="money-screen-icon">↗</div>
    <h3>Withdraw from your wallet</h3>
    <p>Enter the amount you want to withdraw.</p>

    <div class="available-balance">
      Available balance:
      <strong id="withdrawAvailableBalance">0.00 USD</strong>
    </div>

    <label>Amount</label>
    <input
      id="withdrawAmount"
      type="number"
      min="0.01"
      step="0.01"
      placeholder="0.00"
      inputmode="decimal"
    >

    <label>Description</label>
    <input
      id="withdrawDescription"
      type="text"
      placeholder="Description (optional)"
    >

    <button class="primary money-submit" type="button" onclick="withdraw()">
      Continue Withdrawal
    </button>

    <div id="withdrawScreenMessage"></div>
  </div>
</section>

<section id="transferScreen" class="money-screen hidden">
  <div class="money-screen-header">
    <button type="button" class="back-button" onclick="closeMoneyScreen()">←</button>
    <div>
      <small>Vicky Pay</small>
      <h2>Send Money</h2>
    </div>
  </div>

  <div class="money-screen-card">
    <div class="money-screen-icon">⇄</div>
    <h3>Send money</h3>
    <p>Send money securely to another Vicky Pay account.</p>

    <div class="account-id-box">
      <span>My Account ID</span>
      <strong id="transferScreenAccountId">-</strong>
      <button type="button" onclick="copyAccountId()">Copy ID</button>
    </div>

    <label>Recipient Account ID</label>
    <input
      id="recipientAccountId"
      type="text"
      placeholder="VW-12345678"
      maxlength="11"
      autocomplete="off"
      oninput="clearRecipientPreview()"
    >

    <button
      type="button"
      class="secondary"
      onclick="findRecipient()"
    >
      Find Recipient
    </button>

    <div id="recipientPreview" class="recipient-preview hidden"></div>

    <label>Amount</label>
    <input
      id="transferAmount"
      type="number"
      min="0.01"
      step="0.01"
      placeholder="0.00"
      inputmode="decimal"
    >

    <label>Description</label>
    <input
      id="transferDescription"
      type="text"
      placeholder="Description (optional)"
    >

    <button class="primary money-submit" type="button" onclick="transfer()">
      Send Money
    </button>

    <div id="transferScreenMessage"></div>
  </div>
</section>

<section id="historyScreen" class="money-screen hidden">
  <div class="money-screen-header">
    <button type="button" class="back-button" onclick="closeMoneyScreen()">←</button>
    <div>
      <small>Vicky Pay</small>
      <h2>Transaction History</h2>
    </div>
  </div>

  <div class="money-screen-card history-screen-card">
    <div class="money-screen-icon">↻</div>
    <h3>Wallet activity</h3>
    <p>Your recent deposits, withdrawals and transfers.</p>

    <div id="historyScreenTransactions">
      <p class="empty">Loading transactions...</p>
    </div>
  </div>
</section>



      <nav class="mobile-bottom-nav" aria-label="Main navigation">
        <button class="bottom-nav-item active" onclick="scrollToDashboard()">
          <span>⌂</span>
          <small>Home</small>
        </button>
        <button class="bottom-nav-item" onclick="scrollToTransactions()">
          <span>▤</span>
          <small>Transactions</small>
        </button>
        <button class="bottom-nav-item" onclick="openMoneyScreen('depositScreen')">
          <span>＋</span>
          <small>Deposit</small>
        </button>
        <button class="bottom-nav-item" onclick="openProfile()">
          <span>●</span>
          <small>Profile</small>
        </button>
      </nav>

    </section>

  </main>

  <footer>
    <p>© 2026 Vicky Pay</p>
  </footer>

</div>

<script src="app.js"></script>
</body>
</html>
